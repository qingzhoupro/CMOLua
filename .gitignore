# OS
.DS_Store
Thumbs.db
~$*

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# MCP database (user-provided; never commit)
mcp/db/*.db3

# User configuration (contains database path)
.env

# Temp / log
*.tmp
*.log

# IDE - Cursor (structure only)
.cursor/
!.cursor/commands/
!.cursor/skills/
!.cursor/mcp.json

# IDE - Trae (project-level MCP config)
# .trae/ 目录由 install.py 自动创建，包含:
#   commands/  ← 从 .cursor/commands/ 同步，跟踪
#   skills/   ← 从 .cursor/skills/ 同步，跟踪
#   mcp.json  ← 包含用户本地数据库路径，不跟踪
!.trae/commands/
!.trae/skills/
.trae/mcp.json

# IDE - VSCode
.vscode/

# IDE - SpecStory
.specstory/

# outputs/ - 目录结构由 git 跟踪，文件内容不提交
!outputs/
outputs/*
# 保留子目录结构（若需）
!outputs/scenarios/
!outputs/scout/
!outputs/misc/
